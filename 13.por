programa {
  funcao inicio() {
    // Disputa de Produtividade

  inteiro setorA, setorB

  escreva("Digite a produção do setor A: ")
	leia(setorA)

	escreva("Digite a produção do setor B: ")
	leia(setorB)

	se(setorA > setorB)
	{
		escreva("O setor A produziu mais peças.")
	}
	senao
	{
	escreva("O setor B produziu mais peças.")
	}
    
  }
}
