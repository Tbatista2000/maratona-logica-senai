programa {
  funcao inicio() {
  // remessas de parafusos
  inteiro remessa1, remessa2, soma  

  escreva("Digite a quantidade da primeira remessa: ")
  leia(remessa1)
  escreva("Digite a quantidade da segunda remessa: ")
  leia(remessa2)
  
  soma = remessa1 + remessa2
  escreva("O total em estoque é: ", soma)
  
  }
}
