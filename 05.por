programa {
  funcao inicio() {
    // Consumo de Energia

  real media, consumo, maquina1, maquina2, maquina3

  escreva("Digite o consumo da primeira maquina: ")
  leia(maquina1)
  escreva("Digite o consumo da segunda maquina: ")
  leia(maquina2)
  escreva("Digite o consumo da terceira maquina: ")
	leia(maquina3)

  media = (maquina1 + maquina2 + maquina3) / 3
  escreva("A media de consumo é: ", media, " kWh")
  
    
  }
}
