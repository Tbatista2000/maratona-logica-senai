programa {
  funcao inicio() {
    // Espaço de Armazenagem

    real area, largura, comprimento
    escreva("Digite a largura do galpao: ")
		leia(largura)

		escreva("Digite o comprimento do galpao: ")
		leia(comprimento)
    
    area = largura * comprimento

    escreva("A area total do galpao é: ", area, " metros quadrados")
  }
}
